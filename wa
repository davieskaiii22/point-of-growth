#!/bin/bash
# Установка WAHA (WhatsApp HTTP API) + HTTPS (Caddy) на чистый Ubuntu 24.04
set -u
G='\033[1;32m'; R='\033[1;31m'; Y='\033[1;33m'; N='\033[0m'
step(){ echo -e "\n${G}==> $1${N}"; }
fail(){ echo -e "${R}ОШИБКА: $1${N}"; exit 1; }
[ "$(id -u)" = 0 ] || fail "запусти от root"

IP=$(curl -4 -s --max-time 10 https://ifconfig.me || hostname -I | awk '{print $1}')
DOMAIN="$(echo "$IP" | tr . -).sslip.io"
HOOK="https://snowy-math-cada.maxidrom615-000.workers.dev/webhook/whatsapp"
DIR=/opt/waha

step "1/5 Файл подкачки 1 ГБ (защита от нехватки памяти)"
if ! swapon --show | grep -q swapfile; then
  fallocate -l 1G /swapfile && chmod 600 /swapfile && mkswap /swapfile >/dev/null && swapon /swapfile
  grep -q '/swapfile' /etc/fstab || echo '/swapfile none swap sw 0 0' >> /etc/fstab
fi
swapon --show

step "2/5 Устанавливаю Docker"
if ! command -v docker >/dev/null; then
  curl -fsSL https://get.docker.com | sh >/dev/null 2>&1 || fail "не удалось установить Docker"
fi
docker --version

step "3/5 Настраиваю защиту (firewall)"
if command -v ufw >/dev/null; then
  ufw allow 22/tcp >/dev/null; ufw allow 80/tcp >/dev/null; ufw allow 443/tcp >/dev/null
  ufw --force enable >/dev/null
fi

step "4/5 Готовлю WAHA и HTTPS для $DOMAIN"
mkdir -p $DIR && cd $DIR
if [ ! -f .env ]; then
  KEY=$(openssl rand -hex 24)
  PASS=$(openssl rand -hex 10)
  cat > .env <<EOF
WAHA_API_KEY=$KEY
WAHA_DASHBOARD_ENABLED=True
WAHA_DASHBOARD_USERNAME=admin
WAHA_DASHBOARD_PASSWORD=$PASS
WHATSAPP_SWAGGER_USERNAME=admin
WHATSAPP_SWAGGER_PASSWORD=$PASS
WHATSAPP_DEFAULT_ENGINE=GOWS
WHATSAPP_HOOK_URL=$HOOK
WHATSAPP_HOOK_EVENTS=message
WHATSAPP_DOWNLOAD_MEDIA=False
WAHA_PRINT_QR=False
WAHA_BASE_URL=https://$DOMAIN
TZ=Europe/Moscow
EOF
  chmod 600 .env
fi
cat > Caddyfile <<EOF
$DOMAIN {
  reverse_proxy waha:3000
}
EOF
cat > docker-compose.yml <<'EOF'
services:
  waha:
    image: devlikeapro/waha:gows
    restart: always
    env_file: .env
    volumes:
      - ./sessions:/app/.sessions
    logging:
      options: { max-size: "10m", max-file: "2" }
  caddy:
    image: caddy:2
    restart: always
    ports: ["80:80", "443:443"]
    volumes:
      - ./Caddyfile:/etc/caddy/Caddyfile
      - ./caddy_data:/data
    depends_on: [waha]
EOF

step "5/5 Запускаю (первый раз скачивание займёт 1–3 минуты)"
docker compose pull -q || fail "не удалось скачать WAHA"
docker compose up -d || fail "не удалось запустить"
echo "Жду запуск и HTTPS-сертификат…"
OK=""
for i in $(seq 1 40); do
  c=$(curl -s -o /dev/null -w '%{http_code}' --max-time 5 "https://$DOMAIN/ping")
  [ "$c" = "200" ] && OK=1 && break
  sleep 5
done
docker compose ps --format '{{.Name}}: {{.Status}}'

source .env
{
  echo "Панель WAHA:  https://$DOMAIN/dashboard"
  echo "Логин:        admin"
  echo "Пароль:       $WAHA_DASHBOARD_PASSWORD"
  echo "API Key:      $WAHA_API_KEY"
  echo "Адрес для n8n: https://$DOMAIN"
} > /root/waha-credentials.txt
chmod 600 /root/waha-credentials.txt

echo
if [ -n "$OK" ]; then echo -e "${G}ГОТОВО! WAHA работает.${N}"; else echo -e "${Y}WAHA запущена, но HTTPS ещё не ответил. Подожди минуту и открой ссылку ниже.${N}"; fi
echo -e "${Y}Сохрани эти данные себе (никому не пересылай):${N}"
cat /root/waha-credentials.txt
echo -e "\nПосмотреть их снова: cat /root/waha-credentials.txt"
